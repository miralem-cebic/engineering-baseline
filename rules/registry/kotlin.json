[
  {
    "id": "KOT-001",
    "title": "Kotlin warnings are errors",
    "rationale": "allWarningsAsErrors turns style drift into a failing build.",
    "level": "proposed",
    "since": "0.1.0",
    "ecosystems": [
      "kotlin"
    ],
    "checks": [
      {
        "type": "file-contains",
        "paths": [
          "build.gradle.kts",
          "build.gradle"
        ],
        "pattern": "allWarningsAsErrors"
      }
    ]
  },
  {
