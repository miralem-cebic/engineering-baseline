  },
  {
    "id": "CSH-004",
    "title": "Code style is enforced in the build",
    "rationale": "EnforceCodeStyleInBuild makes .editorconfig style rules fail builds.",
    "level": "proposed",
    "since": "0.1.0",
    "ecosystems": [
      "csharp"
    ],
    "checks": [
      {
        "type": "file-contains",
        "paths": [
          "Directory.Build.props"
        ],
        "pattern": "<EnforceCodeStyleInBuild>\\s*true"
      }
    ]
  },
  {
