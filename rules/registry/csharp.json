[
  {
    "id": "CSH-001",
    "title": "Nullable reference types are enabled",
    "rationale": "The compiler tracks null; this is C#'s answer to Option.",
    "level": "proposed",
    "since": "0.1.0",
    "ecosystems": [
      "csharp"
    ],
    "checks": [
      {
        "type": "file-contains",
        "paths": [
          "Directory.Build.props"
        ],
        "pattern": "<Nullable>\\s*enable"
      }
    ]
  },
  {
    "id": "CSH-002",
    "title": "Warnings are errors",
    "rationale": "TreatWarningsAsErrors keeps the build honest.",
    "level": "proposed",
    "since": "0.1.0",
    "ecosystems": [
      "csharp"
    ],
    "checks": [
      {
        "type": "file-contains",
        "paths": [
          "Directory.Build.props"
        ],
        "pattern": "<TreatWarningsAsErrors>\\s*true"
      }
    ]
  },
  {
    "id": "CSH-003",
    "title": "The latest analyzers run at full strength",
    "rationale": "AnalysisLevel latest-all enables every built-in analyzer.",
    "level": "proposed",
    "since": "0.1.0",
    "ecosystems": [
      "csharp"
    ],
    "checks": [
      {
        "type": "file-contains",
        "paths": [
          "Directory.Build.props"
        ],
